{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hook.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
